# OpenAI-compatible provider for the translation system.
# Copy to .env and fill in (.env is gitignored). The model must support image input.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. "json_object" (default) asks the provider for JSON mode; set "none" if it rejects response_format.
LLM_JSON_MODE=json_object
# Optional. "max_tokens" (default); set "max_completion_tokens" if the provider requires it.
LLM_TOKEN_PARAM=max_tokens

# Optional. USD per 1M tokens, used to track spend against the $100 project cap.
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# Optional: the GEMBA-MQM judge (eval/mqm.py, OUTLINE 4.4, 8). A second client with the same variables under the
# JUDGE_ prefix, and a ledger of its own (runs/judge_usage.jsonl): its calls are the evaluation's cost, not the system's,
# and still count against the $100 cap. It must never be LLM_MODEL. Pin a dated snapshot. Each optional variable works
# as its LLM_ counterpart; <PREFIX>_TEMPERATURE and <PREFIX>_REASONING_EFFORT are sent only when set. Prices as OpenAI's
# pricing page listed them on 2026-10-29 (standard tier, USD per 1M tokens).
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=gpt-4o-mini-<date>
# JUDGE_TEMPERATURE=0
# JUDGE_PRICE_INPUT_PER_M=0.15
# JUDGE_PRICE_OUTPUT_PER_M=0.60

# Optional: the judge's fallback, used only if GPT-4o mini fails the human agreement check (OUTLINE 4.5):
# uv run python eval/mqm.py runs/eval/<id> --judge-prefix JUDGE2. A reasoning model: it takes max_completion_tokens
# and a reasoning effort (here the lowest); leave its temperature unset.
# JUDGE2_BASE_URL=https://api.openai.com/v1
# JUDGE2_API_KEY=
# JUDGE2_MODEL=gpt-5.1-<date>
# JUDGE2_TOKEN_PARAM=max_completion_tokens
# JUDGE2_REASONING_EFFORT=none
# JUDGE2_PRICE_INPUT_PER_M=1.25
# JUDGE2_PRICE_OUTPUT_PER_M=10.00

# Optional tracing: one trace per translated page (every provider call, agent step and tool call), in a Phoenix on this machine.
# Start Phoenix by hand: uvx --from arize-phoenix phoenix serve   (UI and OTLP on http://localhost:6006)
# Off unless FUKIDASHI_TRACING is set; "phoenix" is the only backend. Page images are left out of traces.
# The endpoint must be on this machine (localhost, 127.0.0.1 or ::1): traces hold prompts and translations.
# FUKIDASHI_TRACING=phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=fukidashi
